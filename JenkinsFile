pipeline {
    agent any
    stages {
        stage('Checkout') {
            steps {
                git branch: 'main', url: 'https://github.com/Matthiazz123/2526-dotnet-template'
            }
        }
        stage('Deploy') {
            steps {
                withCredentials([string(credentialsId: 'rise-db-connection', variable: 'DB_CONNECTION')]) {
                    sshagent(credentials: ['dmz010-ssh']) {
                        sh 'bash ./deploy/deployServer.sh vagrant@192.0.2.10'
                    }
                }
            }
        }
    }
}
